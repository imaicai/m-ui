#!/usr/bin/env bash
set -Eeuo pipefail

RAW="https://raw.githubusercontent.com/imaicai/m-ui/main"
SERVER_BIN="/usr/local/bin/m-ui-server"
MENU_BIN="/usr/local/bin/m-ui"
CTL_BIN="/usr/local/bin/m-ui-ctl"
SERVICE="/etc/systemd/system/m-ui.service"
DATA_DIR="/etc/m-ui"
DATA_FILE="$DATA_DIR/state.json"
CERT_DIR="/maicai/ssh/m-ui"
XRAY_CONFIG="/usr/local/etc/xray/config.json"

BLUE='\033[0;34m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; RED='\033[0;31m'; CYAN='\033[0;36m'; NC='\033[0m'
line(){ printf '%s\n' '----------------------------------------------------------------------------------'; }
info(){ echo -e "${BLUE}[m-ui]${NC} $*"; }
ok(){ echo -e "${GREEN}[m-ui]${NC} $*"; }
warn(){ echo -e "${YELLOW}[m-ui]${NC} $*"; }
err(){ echo -e "${RED}[m-ui]${NC} $*" >&2; }
pause(){ echo; read -r -p "按回车键返回菜单..." _ || true; }

if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
  if command -v sudo >/dev/null 2>&1; then
    exec sudo "$0" "$@"
  fi
  err "请使用 root 用户执行 m-ui。"
  exit 1
fi

installed(){ [[ -x "$SERVER_BIN" && -f "$SERVICE" ]]; }

panel_port(){
  local p
  p="$(sed -n 's/^Environment=MUI_ADDR=.*:\([0-9][0-9]*\)$/\1/p' "$SERVICE" 2>/dev/null | tail -n1 || true)"
  [[ "$p" =~ ^[0-9]+$ ]] || p="54321"
  printf '%s' "$p"
}

panel_path(){
  if [[ -x "$SERVER_BIN" ]]; then
    "$SERVER_BIN" --print-panel-path 2>/dev/null || printf '/'
  else
    printf '/'
  fi
}

admin_user(){
  if [[ -x "$SERVER_BIN" ]]; then
    "$SERVER_BIN" --print-admin-user 2>/dev/null || printf '-'
  else
    printf '-'
  fi
}

refresh_ip(){
  PUBLIC_IP=""
  COUNTRY=""
  local trace
  trace="$(curl -fsS --max-time 5 https://www.cloudflare.com/cdn-cgi/trace 2>/dev/null || true)"
  if [[ -n "$trace" ]]; then
    PUBLIC_IP="$(printf '%s\n' "$trace" | awk -F= '$1=="ip"{print $2; exit}')"
    COUNTRY="$(printf '%s\n' "$trace" | awk -F= '$1=="loc"{print toupper($2); exit}')"
  fi
  if [[ -z "$PUBLIC_IP" ]]; then
    PUBLIC_IP="$(curl -4 -fsS --max-time 5 https://api.ipify.org 2>/dev/null || true)"
  fi
  [[ -n "$PUBLIC_IP" ]] || PUBLIC_IP="获取失败"
  [[ -n "$COUNTRY" ]] || COUNTRY="--"
}

panel_host(){
  if [[ "$PUBLIC_IP" == *:* ]]; then
    printf '[%s]' "$PUBLIC_IP"
  else
    printf '%s' "$PUBLIC_IP"
  fi
}

service_status(){
  if systemctl is-active --quiet m-ui 2>/dev/null; then
    echo -e "${GREEN}运行中${NC}"
  elif systemctl is-enabled --quiet m-ui 2>/dev/null; then
    echo -e "${YELLOW}已停止${NC}"
  else
    echo -e "${RED}未安装${NC}"
  fi
}

bbr_status(){
  local cc q
  cc="$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || true)"
  q="$(sysctl -n net.core.default_qdisc 2>/dev/null || true)"
  if [[ "$cc" == "bbr" && "$q" == "fq" ]]; then
    printf 'BBR + FQ'
  elif [[ -n "$cc" || -n "$q" ]]; then
    printf '%s + %s' "${cc:---}" "${q:---}"
  else
    printf '未知'
  fi
}

show_parameters(){
  refresh_ip
  local port path user version status
  port="$(panel_port)"
  path="$(panel_path)"
  user="$(admin_user)"
  version="$("$SERVER_BIN" --version 2>/dev/null | awk '{print $2}' || true)"
  [[ -n "$version" ]] || version="-"
  status="$(service_status)"
  echo -e "${CYAN}m-ui 管理脚本 · MiniJet${NC}"
  line
  printf '版本: %s\n' "$version"
  echo -e "状态: $status"
  printf '公网IP: %s    国家: %s\n' "$PUBLIC_IP" "$COUNTRY"
  printf '登录用户: %s    端口: %s    根路径: %s\n' "$user" "$port" "$path"
  if [[ "$PUBLIC_IP" != "获取失败" ]]; then
    printf '面板地址: http://%s:%s%s\n' "$(panel_host)" "$port" "$path"
  fi
  printf '网络加速: %s\n' "$(bbr_status)"
  line
}

open_port(){
  local port="$1"
  if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -qi 'Status: active'; then
    ufw allow "${port}/tcp" >/dev/null 2>&1 || true
  elif command -v firewall-cmd >/dev/null 2>&1 && firewall-cmd --state >/dev/null 2>&1; then
    firewall-cmd --permanent --add-port="${port}/tcp" >/dev/null 2>&1 || true
    firewall-cmd --reload >/dev/null 2>&1 || true
  fi
}

set_port(){
  local port="$1"
  [[ "$port" =~ ^[0-9]+$ ]] && (( port >= 1024 && port <= 65535 )) || { err "端口必须在 1024-65535 之间。"; return 1; }
  local current
  current="$(panel_port)"
  if [[ "$port" != "$current" ]] && command -v ss >/dev/null 2>&1 && ss -lntH 2>/dev/null | awk '{print $4}' | grep -Eq "[:.]$port$"; then
    err "端口 $port 已被其他程序占用。"
    return 1
  fi
  [[ -f "$SERVICE" ]] || { err "m-ui 尚未安装。"; return 1; }
  sed -i -E "s#^Environment=MUI_ADDR=.*#Environment=MUI_ADDR=0.0.0.0:${port}#" "$SERVICE"
  systemctl daemon-reload
  open_port "$port"
}

restart_panel(){
  systemctl restart m-ui
  sleep 1
  if systemctl is-active --quiet m-ui; then
    ok "m-ui 已重启。"
  else
    err "m-ui 启动失败，最近日志："
    journalctl -u m-ui --no-pager -n 30
    return 1
  fi
}

install_panel(){
  info "开始一键安装/升级 m-ui..."
  bash <(curl -fsSL --retry 3 "$RAW/install.sh")
}

purge_panel(){
  echo -e "${RED}此操作会删除 m-ui 程序、节点、订阅、登录信息、证书目录及 m-ui 生成的 Xray 配置。${NC}"
  warn "Xray Core 本体不会卸载。"
  read -r -p "确认彻底删除请输入 DELETE: " confirm
  [[ "$confirm" == "DELETE" ]] || { warn "已取消。"; return; }

  local script="/opt/m-ui-src/uninstall.sh"
  if [[ -f "$script" ]]; then
    bash "$script" --purge
  else
    local tmp
    tmp="$(mktemp)"
    curl -fsSL --retry 3 "$RAW/uninstall.sh" -o "$tmp"
    bash "$tmp" --purge
    rm -f "$tmp"
  fi
  echo
  ok "m-ui 已彻底卸载。"
  exit 0
}

update_scripts(){
  local tmp_menu tmp_ctl
  tmp_menu="$(mktemp)"
  tmp_ctl="$(mktemp)"
  curl -fsSL --retry 3 "$RAW/m-ui" -o "$tmp_menu"
  curl -fsSL --retry 3 "$RAW/m-ui-ctl" -o "$tmp_ctl"
  bash -n "$tmp_menu"
  bash -n "$tmp_ctl"
  install -m 0755 "$tmp_menu" "$MENU_BIN"
  install -m 0755 "$tmp_ctl" "$CTL_BIN"
  rm -f "$tmp_menu" "$tmp_ctl"
  ok "m-ui SSH 管理脚本已更新。"
}

settings_menu(){
  installed || { err "请先安装 m-ui。"; pause; return; }
  while true; do
    clear
    echo -e "${CYAN}m-ui 面板设置${NC}"
    line
    echo " 1. 修改登录用户名"
    echo " 2. 修改登录密码"
    echo " 3. 修改登录端口"
    echo " 4. 修改面板根路径"
    echo " 5. 还原面板登录设置"
    echo " 0. 返回主菜单"
    line
    read -r -p "请选择 [0-5]: " choice
    case "$choice" in
      1)
        read -r -p "请输入新的登录用户名: " user
        [[ -n "$user" ]] || { err "用户名不能为空。"; pause; continue; }
        "$SERVER_BIN" --set-admin-user "$user"
        restart_panel
        ok "登录用户名已修改为: $user"
        pause
        ;;
      2)
        local p1 p2
        read -r -s -p "请输入新密码（至少8位）: " p1; echo
        read -r -s -p "请再次输入新密码: " p2; echo
        [[ "$p1" == "$p2" ]] || { err "两次输入的密码不一致。"; pause; continue; }
        "$SERVER_BIN" --set-admin-password "$p1"
        restart_panel
        ok "登录密码已修改。"
        pause
        ;;
      3)
        local port
        read -r -p "请输入新的登录端口 [1024-65535]: " port
        if set_port "$port"; then
          restart_panel
          ok "面板登录端口已修改为: $port"
        fi
        pause
        ;;
      4)
        local path
        read -r -p "请输入新的根路径（例如 /a8f3k2m9/）: " path
        [[ -n "$path" ]] || { err "根路径不能为空。"; pause; continue; }
        "$SERVER_BIN" --set-panel-path "$path"
        restart_panel
        ok "面板根路径已修改为: $(panel_path)"
        pause
        ;;
      5)
        warn "还原面板会保留节点和订阅，但重置：用户名=admin、随机密码、端口=54321、随机根路径。"
        read -r -p "确认还原请输入 YES: " yes
        if [[ "$yes" == "YES" ]]; then
          echo
          "$SERVER_BIN" --reset-panel-access
          set_port 54321
          restart_panel
          echo
          warn "请保存上方新的管理员密码。"
        else
          warn "已取消。"
        fi
        pause
        ;;
      0) return ;;
      *) err "无效选项。"; sleep 1 ;;
    esac
  done
}

service_menu(){
  installed || { err "请先安装 m-ui。"; pause; return; }
  clear
  echo -e "${CYAN}m-ui 服务控制${NC}"
  line
  echo " 1. 关闭 m-ui"
  echo " 2. 重启 m-ui"
  echo " 3. 启动 m-ui"
  echo " 0. 返回主菜单"
  line
  read -r -p "请选择 [0-3]: " choice
  case "$choice" in
    1) systemctl stop m-ui; ok "m-ui 已关闭。" ;;
    2) restart_panel ;;
    3) systemctl start m-ui; ok "m-ui 已启动。" ;;
    0) return ;;
    *) err "无效选项。" ;;
  esac
  pause
}

show_logs(){
  installed || { err "请先安装 m-ui。"; pause; return; }
  echo "按 Ctrl+C 退出日志查看。"
  sleep 1
  journalctl -u m-ui -f --no-pager -n 100 || true
}

enable_bbr_fq(){
  info "检查当前内核是否支持原版 BBR..."
  modprobe tcp_bbr 2>/dev/null || true
  local available
  available="$(sysctl -n net.ipv4.tcp_available_congestion_control 2>/dev/null || true)"
  if [[ " $available " != *" bbr "* ]]; then
    err "当前 Linux 内核未提供 BBR，未做任何内核替换。"
    warn "可用拥塞控制: ${available:-未知}"
    pause
    return
  fi

  mkdir -p /etc/modules-load.d /etc/sysctl.d
  printf 'tcp_bbr\n' > /etc/modules-load.d/m-ui-bbr.conf
  cat > /etc/sysctl.d/99-m-ui-bbr.conf <<'EOF'
# m-ui: Linux kernel native BBR + FQ
net.core.default_qdisc=fq
net.ipv4.tcp_congestion_control=bbr
EOF

  sysctl -w net.core.default_qdisc=fq >/dev/null
  sysctl -w net.ipv4.tcp_congestion_control=bbr >/dev/null
  ok "已启用并持久化原版 BBR + FQ。"
  printf 'tcp_congestion_control = %s\n' "$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || echo unknown)"
  printf 'default_qdisc = %s\n' "$(sysctl -n net.core.default_qdisc 2>/dev/null || echo unknown)"
  pause
}

refresh_display(){
  clear
  echo -e "${CYAN}刷新 IP 配置及参数显示${NC}"
  line
  show_parameters
  echo
  info "已重新获取当前公网 IP、国家、面板端口、根路径、登录用户和 BBR/FQ 状态。"
  warn "此操作只刷新服务器参数显示，不会擅自改写已经创建的节点。"
  pause
}

main_menu(){
  while true; do
    clear
    show_parameters
    echo
    echo " 1. 一键安装 m-ui"
    echo " 2. 删除卸载 m-ui （包含卸载所有配置）"
    echo " 3. 更新 m-ui 脚本"
    line
    echo " 4. 变更 m-ui 面板设置 【用户名密码、登录端口、根路径、还原面板】"
    echo " 5. 关闭、重启 m-ui"
    line
    echo " 6. 查看 m-ui 运行日志"
    echo " 7. 一键原版BBR+FQ加速"
    echo " 8. 刷新IP配置及参数显示"
    line
    read -r -p "请输入选项 [1-8，q退出]: " choice
    case "$choice" in
      1) install_panel; pause ;;
      2) purge_panel ;;
      3) update_scripts; pause ;;
      4) settings_menu ;;
      5) service_menu ;;
      6) show_logs ;;
      7) enable_bbr_fq ;;
      8) refresh_display ;;
      q|Q|exit) exit 0 ;;
      *) err "无效选项。"; sleep 1 ;;
    esac
  done
}

main_menu
